+# OpenAPI 3.1 contract for yagura's HTTP API.
+#
+# Hand-authored (ADR-0001: zero external deps — no spec-generation framework).
+# Covers the operational + CI-integration HTTP surface. The MCP JSON-RPC tool
+# surface is contracted separately by tools/list + the golden test
+# (internal/mcp/testdata/tools_list_contract.golden.json) — see docs/MCP_TOOLS.md.
+#
+# Stability: this file is part of the versioned public surface per ADR-0007.
+openapi: 3.1.0
+info:
+  title: yagura HTTP API
+  version: 0.34.1
+  description: >
+    Operational and CI-integration HTTP endpoints for the yagura portfolio
+    orchestrator. The primary agent surface is MCP JSON-RPC at POST /mcp; the
+    /sbom, /gha-audit and /pin-drift routes exist so CI pipelines can call the
+    scanners directly with curl instead of JSON-RPC.
+  license:
+    name: MIT
+servers:
+  - url: http://127.0.0.1:8090
+    description: Default loopback bind (ADR-0004, YAGURA_ADDR). Port is configurable.
+
+components:
+  securitySchemes:
+    bearerAuth:
+      type: http
+      scheme: bearer
+      description: >
+        Optional. When YAGURA_MCP_TOKEN is set, the /sbom, /gha-audit and
+        /pin-drift routes require Authorization: Bearer <token>. When unset
+        (loopback-only default) no auth is enforced.
+  schemas:
+    WorkflowFiles:
+      type: object
+      description: Map of file path to file content (e.g. workflow YAML).
+      properties:
+        files:
+          type: object
+          additionalProperties:
+            type: string
+        summary_only:
+          type: boolean
+          description: Return only a summary instead of the full result.
+        concurrency:
+          type: integer
+          description: >
+            Streaming concurrency for /pin-drift (default 4, clamped to 64).
+      required: [files]
+    Error:
+      type: object
+      properties:
+        error:
+          type: string
+
+paths:
+  /healthz:
+    get:
+      summary: Liveness probe
+      security: []
+      responses:
+        "200":
+          description: Always "ok" while the process is alive.
+          content:
+            text/plain:
+              schema: { type: string, example: ok }
+  /readyz:
+    get:
+      summary: Readiness probe
+      security: []
+      responses:
+        "200":
+          description: Ready to serve.
+          content:
+            text/plain:
+              schema: { type: string, example: ready }
+        "503":
+          description: Draining / not ready.
+          content:
+            text/plain:
+              schema: { type: string, example: draining }
+  /metrics:
+    get:
+      summary: Prometheus metrics (scan counters + tool/alert/hook gauges)
+      security: []
+      responses:
+        "200":
+          description: Prometheus text exposition format.
+          content:
+            text/plain: {}
+  /.well-known/mcp:
+    get:
+      summary: MCP server capability discovery (MCP 2026 spec)
+      security: []
+      responses:
+        "200":
+          description: Server name, version, transport, endpoints and capabilities.
+          content:
+            application/json: {}
+  /mcp:
+    post:
+      summary: MCP JSON-RPC endpoint (tools/list, tools/call, initialize)
+      description: >
+        JSON-RPC 2.0. GET returns 405. The tool surface is documented in
+        docs/MCP_TOOLS.md and pinned by the tools/list golden test.
