+// tools_scan.go: cortex flywheel ② Review の scan 系 tools
+// (secretscan / sbom / gha_audit / pin_drift)。tools.go から分割(挙動非変更)。
+package mcp
+
+import (
+	"context"
+	"encoding/json"
