+				}
+				path := filepath.Join(p.LocalPath, "feature-list.json")
+				if err := atomicWriteFile(path, raw, 0o644); err != nil {
+					return nil, &ToolError{Code: "write_failed", Message: err.Error()}
+				}
+				result["written_to"] = path
+			}
+			return result, nil
+		},
