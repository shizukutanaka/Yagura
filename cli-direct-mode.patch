+	if err != nil {
+		return errUsage
+	}
+	if len(pos) < 2 {
+		return fmt.Errorf("usage: yagura register <slug> <repository> [flags]")
+	}
+	slug, repo := pos[0], pos[1]
+	dn := *displayName
+	if dn == "" {
+		dn = slug
+	}
+	st := project.Stage(strings.ToLower(strings.TrimSpace(*stage)))
+	if st == "" {
+		st = project.StageActive
+	}
+	p := &project.Project{
+		Slug:        slug,
+		DisplayName: dn,
+		Repository:  repo,
