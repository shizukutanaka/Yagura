+	}
+	if err := json.Unmarshal(args, &in); err != nil {
+		return 0, &ToolError{Code: "invalid_input", Message: "invalid args", Cause: err}
+	}
+	if in.Limit < 0 {
+		return 0, nil
+	}
+	return in.Limit, nil
