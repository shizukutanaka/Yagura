+			return fmt.Errorf("read %s: %w", p, err)
+		}
+		res := harness.AuditWorkflow(string(data))
+		if len(res.Issues) > 0 {
+			flaggedCount++
+		}
+		if *flaggedOnly && len(res.Issues) == 0 {
+			continue
+		}
+		entries = append(entries, workflowAuditEntry{Path: p, WorkflowAuditResult: res})
+	}
