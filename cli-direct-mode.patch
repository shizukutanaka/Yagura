+func runCLICapture(t *testing.T, args ...string) (code int, stdout, stderr string) {
+	t.Helper()
+	var out, errBuf bytes.Buffer
+	verb := ""
+	rest := []string{}
+	if len(args) > 0 {
+		verb = args[0]
+		rest = args[1:]
+	}
+	code = runCLI(verb, rest, &out, &errBuf)
+	return code, out.String(), errBuf.String()
+}
