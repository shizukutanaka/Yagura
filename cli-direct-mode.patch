+		t.Error("AlertStore() did not return the value passed to SetAlertStore()")
+	}
+
+	s.SetAlertStore(nil)
+	if s.AlertStore() != nil {
+		t.Error("expected nil after SetAlertStore(nil)")
+	}
+}
