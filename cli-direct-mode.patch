+	// register (flags trailing the positionals)
+	code, _, errs := runCLICapture(t, "register", "breeze", "shizukutanaka/breeze",
+		"--language", "go", "--priority", "3", "--tags", "rust,cli")
+	if code != 0 {
+		t.Fatalf("register: code=%d err=%q", code, errs)
