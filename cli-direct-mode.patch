+func TestCLI_SecretScan(t *testing.T) {
+	t.Setenv("YAGURA_STATE_DIR", t.TempDir())
+	// empty registry → 0 findings
+	if code, out, _ := runCLICapture(t, "secretscan"); code != 0 || !strings.Contains(out, "total_findings: 0") {
