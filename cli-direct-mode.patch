+// ─── SetAlertStore / AlertStore ──────────────────────────────────
+
+func TestSetAlertStore_RoundTrip(t *testing.T) {
+	s := New("", logging.Discard())
+	if s.AlertStore() != nil {
+		t.Error("expected nil AlertStore on fresh server")
+	}
+
+	st, err := alertfix.NewStore(t.TempDir() + "/alerts.jsonl")
