+func TestCLI_PublicityScanStrict(t *testing.T) {
+	t.Setenv("YAGURA_STATE_DIR", t.TempDir())
+	dir := t.TempDir()
+	// clean file → --strict exits 0.
+	if err := os.WriteFile(filepath.Join(dir, "clean.md"), []byte("open http://127.0.0.1:8090\n"), 0o644); err != nil {
