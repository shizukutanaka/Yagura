+// ─── publicity-scan ──────────────────────────────────────────
+
+func humanPublicityScan(w io.Writer, findings []publicityFinding, scanned int) {
+	bare := make([]publicityscan.Finding, len(findings))
+	for i, f := range findings {
+		bare[i] = f.Finding
+	}
