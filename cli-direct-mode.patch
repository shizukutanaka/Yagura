+		t.Fatalf("get: code=%d", code)
+	}
+	for _, want := range []string{"language: ", "go", "priority: ", "3", "rust, cli"} {
+		if !strings.Contains(out, want) {
+			t.Errorf("get output missing %q in:\n%s", want, out)
+		}
