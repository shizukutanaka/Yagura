+func TestAuditWorkflow_SortByAbsoluteScore(t *testing.T) {
+	src := `
+const ideas = await parallel(seeds.map(s => () => agent("score this idea", { model: "haiku", maxTokens: 1000 })))
+const ranked = ideas.sort((a, b) => b.score - a.score)
