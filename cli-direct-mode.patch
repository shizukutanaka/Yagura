+      "agents": {"defaults": {"model": {"primary": "vllm/missing"}}},
+      "models": {"providers": {"vllm": {"apiKey": "EMPTY", "models": [{"id": "qwen3.6-27b", "contextWindow": 262144, "maxTokens": 32768}]}}}
