# Yagura configuration — copy to .env and customize.
# Do NOT commit .env; it should be gitignored.
#
# Only YAGURA_GITHUB_TOKEN is required. All other values shown are defaults.

# ─── Required ────────────────────────────────────────────────

# GitHub personal access token.
# Use fine-grained PAT with metadata:read only.
# Token must start with ghp_, github_pat_, gho_, ghs_, or ghu_.
YAGURA_GITHUB_TOKEN=ghp_REPLACE_WITH_YOUR_TOKEN

# ─── Recommended for production ──────────────────────────────

# Bearer token for MCP endpoint authentication.
# Empty = no auth (loopback bind only).
# If YAGURA_ADDR is non-loopback, this becomes mandatory at startup.
# Generate via: openssl rand -base64 32
# YAGURA_MCP_TOKEN=

# Listen address. Default 127.0.0.1:8090 (loopback only).
# Set to 0.0.0.0:8090 or specific interface if remote access is needed.
# YAGURA_ADDR=127.0.0.1:8090

# ─── Optional ────────────────────────────────────────────────

# Where projects/, audit/, drafts/ are stored.
# Default: $HOME/.yagura/state
# YAGURA_STATE_DIR=

# Logging level: debug | info | warn | error
# YAGURA_LOG_LEVEL=info

# GitHub poll interval. Minimum 30s.
# Examples: 5m, 10m, 1h
# YAGURA_SCAN_INTERVAL=5m

# Per-request timeout for GitHub API calls.
# YAGURA_SCAN_TIMEOUT=30s

# Audit log retention (days). 0 = keep forever.
# YAGURA_AUDIT_KEEP_DAYS=90

# Enable pprof endpoints at /debug/pprof/* (development only).
# YAGURA_ENABLE_PPROF=false

# GitHub API base URL. Override for GitHub Enterprise Server.
# YAGURA_GITHUB_BASE=https://api.github.com
